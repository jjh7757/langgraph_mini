# 이 파일을 .env로 복사한 뒤 실제 키를 채우세요. .env는 .gitignore에 있어 커밋되지 않습니다.

# https://aistudio.google.com/apikey 에서 발급
GOOGLE_API_KEY=

# 선택 사항 (안 채우면 기본값 사용)
# GEMINI_MODEL=gemini-2.5-flash
# LANGGRAPH_MINI_DATA_DIR=data
# LANGGRAPH_MINI_THREAD_ID=default

# 웹 채팅(api/app.py)을 로컬에서 띄울 때만 필요 — docker-compose.dev.yml로 띄운
# Postgres/Redis 기준 기본값. 서버 배포 시에는 /srv/<앱>/.env에 실제 값을 넣는다
# (TIL DB환경구성.md의 "새 프로젝트에 DB 붙이기" 참고).
# DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/postgres
# REDIS_URL=redis://localhost:6379/0
